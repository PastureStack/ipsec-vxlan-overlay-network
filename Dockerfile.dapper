# syntax=docker/dockerfile:1.7
FROM golang:1.27.4-bookworm@sha256:4fa7c968ba93f1635670522dbb01a2c78150443e1385746924566079f36570ea AS docker_cli
ADD --checksum=sha256:36d502ba53623c50c51fe44f916aeff4c4051b1132aabde2e8982895d0361651 https://codeload.github.com/docker/cli/tar.gz/5457199aa57c45e990c59c89cab5f02b817238d7 /tmp/docker-cli.tgz
WORKDIR /build
RUN set -eux; \
    test "$(go env GOVERSION)" = go1.27.4; \
    tar -xzf /tmp/docker-cli.tgz --strip-components=1; \
    cp vendor.mod go.mod; \
    cp vendor.sum go.sum; \
    export GOTOOLCHAIN=local GOFLAGS=-mod=mod GOPROXY=https://proxy.golang.org GOSUMDB=sum.golang.org; \
    go get golang.org/x/net@v0.62.0; \
    go mod download; \
    go mod verify; \
    export GOPROXY=off; \
    CGO_ENABLED=1 go build -trimpath -buildvcs=false -tags 'grpcnotrace osusergo netgo' \
        -ldflags '-X github.com/docker/cli/cli/version.GitCommit=5457199 -X github.com/docker/cli/cli/version.Version=29.9.3 -linkmode external -extldflags=-static' \
        -o /out/docker ./cmd/docker; \
    go version -m /out/docker > /out/docker-go-version.txt; \
    grep -F 'go1.27.4' /out/docker-go-version.txt; \
    awk '$1=="dep" && $2=="golang.org/x/net" && $3=="v0.62.0" { found=1 } END { exit !found }' /out/docker-go-version.txt; \
    sha256sum /out/docker | cut -d' ' -f1 > /out/docker.sha256

FROM ubuntu:26.04@sha256:2260313b31c8c011cd2eebe728008efac1b3982be73eb71348ea2648d2c0e09b

COPY ubuntu-apt.lock /licenses/ubuntu-apt.lock
COPY security/install-ubuntu-security-updates.sh /usr/local/lib/pasturestack/install-ubuntu-security-updates.sh
COPY security/ubuntu-security-packages.lock /usr/share/pasturestack/ubuntu-security-packages.lock

ADD --checksum=sha256:a7e3bf769aec16ba21ca39cba180d6d311dafcbae68346a05f137c5cc26c9ca6 https://security.ubuntu.com/ubuntu/pool/main/c/ca-certificates/ca-certificates_20260816ubuntu0.26.04.2_all.deb /tmp/ca-certificates.deb
ADD --checksum=sha256:0de729b8fe0e1c67c04e8e8d5bd6e0420dbd47f75b93f0b71c8e740edc2d5ffc \
    https://security.ubuntu.com/ubuntu/pool/main/a/apt/apt_3.2.1ubuntu0.1_amd64.deb \
    /tmp/apt.deb
ADD --checksum=sha256:94e5d41303265b66af0f8c70ade18bfb77260ad286edee6c8045faddef82b94c \
    https://security.ubuntu.com/ubuntu/pool/main/a/apt/libapt-pkg7.0_3.2.1ubuntu0.1_amd64.deb \
    /tmp/libapt-pkg7.0.deb
ADD --checksum=sha256:44742b1e9c947ebb3b82215c13d968bd54e2e60bc42244af69301c5d057bb340 https://snapshot.ubuntu.com/ubuntu/20260930T000000Z/pool/main/o/openssl/libssl3t64_3.5.5-1ubuntu3.6_amd64.deb /tmp/pasturestack-libssl3t64.deb
ADD --checksum=sha256:588e7f17afb9263a348c9587330805fc856536402328bec1660ff3a95e61bb4c https://snapshot.ubuntu.com/ubuntu/20260930T000000Z/pool/main/o/openssl/openssl_3.5.5-1ubuntu3.6_amd64.deb /tmp/pasturestack-openssl.deb
ADD --checksum=sha256:1b582b937a1f7a8f987da9e1bbfcc806faea714267631ce0fbbd352c924b7daf https://snapshot.ubuntu.com/ubuntu/20260930T000000Z/pool/main/o/openssl/openssl-provider-legacy_3.5.5-1ubuntu3.6_amd64.deb /tmp/pasturestack-openssl-provider-legacy.deb

ADD --checksum=sha256:bedeef1cf3268f90338c411cdb0a45b224d0660fd2240f310f380316c8244606 https://security.ubuntu.com/ubuntu/pool/main/b/brotli/libbrotli1_1.2.0-3ubuntu0.1_amd64.deb /tmp/libbrotli1-security.deb

ADD --checksum=sha256:44ebbeb6493eacffbc460ca71446959ba86a00b2e23515e4cfb1a5cc317d6672 https://security.ubuntu.com/ubuntu/pool/main/p/pcre2/libpcre2-8-0_10.46-1ubuntu0.1_amd64.deb /tmp/libpcre2-security.deb
ADD --checksum=sha256:963dbc5efa92141e7056a9e9f3431ec7f352f2a7c762f2b3242443df39be9115 https://archive.ubuntu.com/ubuntu/pool/main/r/rust-coreutils/rust-coreutils_0.10.0-1ubuntu2~26.04.1_amd64.deb /tmp/rust-coreutils-security.deb

ARG DAPPER_HOST_ARCH=amd64
ARG GO_VERSION=1.27.4
ARG GO_LINUX_AMD64_SHA256=7226736c2339719cda28fbf3a54d71aa63bcefe376e98cef00034268dab24840

ENV DEBIAN_FRONTEND=noninteractive
ENV HOST_ARCH=${DAPPER_HOST_ARCH} ARCH=${DAPPER_HOST_ARCH}

RUN set -eux; \
    . /licenses/ubuntu-apt.lock; \
    rm -f /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources; \
    rm -rf /tmp/ca-bootstrap; \
    mkdir -p /tmp/ca-bootstrap /etc/ssl/certs; \
    dpkg-deb --extract /tmp/ca-certificates.deb /tmp/ca-bootstrap; \
    find /tmp/ca-bootstrap/usr/share/ca-certificates -type f -name '*.crt' \
        | LC_ALL=C sort \
        | while IFS= read -r certificate; do sed -e '$a\' "${certificate}"; done \
        > /etc/ssl/certs/ca-certificates.crt; \
    test -s /etc/ssl/certs/ca-certificates.crt; \
    printf 'Types: deb\nURIs: https://snapshot.ubuntu.com/ubuntu/%s\nSuites: resolute resolute-updates resolute-backports resolute-security\nComponents: main universe restricted multiverse\nSigned-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg\nSnapshot: no\n' \
        "${UBUNTU_APT_SNAPSHOT}" > /etc/apt/sources.list.d/pasturestack-snapshot.sources; \
    printf 'Acquire::Retries "5";\nAcquire::http::Timeout "30";\nAcquire::https::Timeout "30";\nAcquire::http::Pipeline-Depth "0";\nAcquire::https::CaInfo "/etc/ssl/certs/ca-certificates.crt";\nAcquire::https::Verify-Peer "true";\nAcquire::https::Verify-Host "true";\nAcquire::AllowInsecureRepositories "false";\nAPT::Get::AllowUnauthenticated "false";\n' > /etc/apt/apt.conf.d/80pasturestack-retries; \
    dpkg -i /tmp/apt.deb /tmp/libapt-pkg7.0.deb; \
    for package in apt libapt-pkg7.0; do \
        test "$(dpkg-query -W -f='${Version}' "$package")" = '3.2.1ubuntu0.1'; \
    done; \
    rm -f /tmp/apt.deb /tmp/libapt-pkg7.0.deb; \
    apt-get update --error-on=any; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        /tmp/pasturestack-libssl3t64.deb \
        /tmp/pasturestack-openssl.deb \
        /tmp/pasturestack-openssl-provider-legacy.deb \
        /tmp/ca-certificates.deb \
        curl="${UBUNTU_APT_CURL_VERSION}" \
        file="${UBUNTU_APT_FILE_VERSION}" \
        gcc="${UBUNTU_APT_GCC_VERSION}" \
        git="${UBUNTU_APT_GIT_VERSION}" \
        jq="${UBUNTU_APT_JQ_VERSION}" \
        libc6-dev="${UBUNTU_APT_LIBC6_DEV_VERSION}" \
        make="${UBUNTU_APT_MAKE_VERSION}" \
        tar="${UBUNTU_APT_TAR_VERSION}" \
        xz-utils="${UBUNTU_APT_XZ_UTILS_VERSION}"; \
    test "$(dpkg-query -W -f='${Version}' ca-certificates)" = "${UBUNTU_APT_CA_CERTIFICATES_VERSION}"; \
    for package in openssl libssl3t64 openssl-provider-legacy; do \
        test "$(dpkg-query -W -f='${Version}' "$package")" = "${UBUNTU_APT_OPENSSL_VERSION}"; \
    done; \
    sh /usr/local/lib/pasturestack/install-ubuntu-security-updates.sh /usr/share/pasturestack/ubuntu-security-packages.lock /etc/ssl/certs/ca-certificates.crt; \
    printf '%s\n' libperl5.40=5.40.1-7ubuntu0.4 perl=5.40.1-7ubuntu0.4 perl-base=5.40.1-7ubuntu0.4 perl-modules-5.40=5.40.1-7ubuntu0.4 > /tmp/ubuntu-perl-security.lock; \
    UBUNTU_SECURITY_ARCHIVE=https://archive.ubuntu.com/ubuntu sh /usr/local/lib/pasturestack/install-ubuntu-security-updates.sh /tmp/ubuntu-perl-security.lock /etc/ssl/certs/ca-certificates.crt; \
    rm -f /tmp/ubuntu-perl-security.lock; \
    test "$(dpkg-deb -f /tmp/libbrotli1-security.deb Package)" = libbrotli1; \
    test "$(dpkg-deb -f /tmp/libbrotli1-security.deb Version)" = 1.2.0-3ubuntu0.1; \
    test "$(dpkg-deb -f /tmp/libbrotli1-security.deb Architecture)" = amd64; \
    dpkg -i /tmp/libbrotli1-security.deb; \
    test "$(dpkg-query -W -f='${Version}' libbrotli1)" = 1.2.0-3ubuntu0.1; \
    rm -f /tmp/libbrotli1-security.deb; \
    for spec in 'libpcre2-security libpcre2-8-0 10.46-1ubuntu0.1' 'rust-coreutils-security rust-coreutils 0.10.0-1ubuntu2~26.04.1'; do \
        set -- $spec; \
        test "$(dpkg-deb -f "/tmp/$1.deb" Package)" = "$2"; \
        test "$(dpkg-deb -f "/tmp/$1.deb" Version)" = "$3"; \
        test "$(dpkg-deb -f "/tmp/$1.deb" Architecture)" = amd64; \
        dpkg -i "/tmp/$1.deb"; \
        test "$(dpkg-query -W -f='${Version}' "$2")" = "$3"; \
    done; \
    dpkg-query -W -f='${binary:Package}\t${Version}\n' | LC_ALL=C sort > /usr/share/pasturestack/ubuntu-security-packages.tsv; \
    { printf 'snapshot\t%s\n' "${UBUNTU_APT_SNAPSHOT}"; dpkg-query -W -f='${binary:Package}\t${Version}\n' | LC_ALL=C sort; } \
        > /licenses/IPSEC-VXLAN-OVERLAY-DAPPER-UBUNTU-APT-PACKAGES.tsv; \
    rm -rf /var/lib/apt/lists/* && \
    rm -rf /tmp/* /var/tmp/* && \
    rm -f /usr/bin/pebble && \
    rm -f /bin/sh && ln -s /bin/bash /bin/sh

ENV GOPATH=/go \
    PATH=/go/bin:/usr/local/go/bin:${PATH} \
    SHELL=/bin/bash \
    GOFLAGS=-mod=vendor \
    GOWORK=off \
    GOCACHE=/tmp/go-build-cache \
    GOTELEMETRY=off \
    XDG_CONFIG_HOME=/tmp/go-config \
    GIT_CONFIG_GLOBAL=/tmp/gitconfig

RUN test "${DAPPER_HOST_ARCH}" = amd64 && \
    curl -fsSL -o /tmp/go.tgz "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" && \
    echo "${GO_LINUX_AMD64_SHA256}  /tmp/go.tgz" | sha256sum -c - && \
    tar -xzf /tmp/go.tgz -C /usr/local && \
    rm -f /tmp/go.tgz && \
    go version

COPY --from=docker_cli /out/docker /usr/bin/docker
COPY --from=docker_cli /out/docker-go-version.txt /usr/share/pasturestack/docker-go-version.txt

ENV DAPPER_ENV="REPO IMAGE_NAMESPACE TAG IMAGE_REVISION VERSION_OVERRIDE RELEASE_VERSION SOURCE_DATE_EPOCH METADATA_CNI_IPAM_BINARY METADATA_CNI_IPAM_URL METADATA_CNI_IPAM_SHA256 PER_HOST_SUBNET_BINARY PER_HOST_SUBNET_URL PER_HOST_SUBNET_SHA256 HOST_LOCAL_CNI_IPAM_BINARY HOST_LOCAL_CNI_IPAM_URL HOST_LOCAL_CNI_IPAM_SHA256 FLAT_CNI_IPAM_BINARY FLAT_CNI_IPAM_URL FLAT_CNI_IPAM_SHA256 MOUNT_PROPAGATION_BINARY MOUNT_PROPAGATION_URL MOUNT_PROPAGATION_SHA256 DOCKER_BUILD_NETWORK"
ENV DAPPER_SOURCE=/go/src/github.com/PastureStack/ipsec-vxlan-overlay-network
ENV DAPPER_OUTPUT="./bin ./dist"
ENV DAPPER_DOCKER_SOCKET=true
ENV HOME=${DAPPER_SOURCE}
WORKDIR ${DAPPER_SOURCE}

RUN git config --system --add safe.directory ${DAPPER_SOURCE}

ENTRYPOINT ["./scripts/entry"]
CMD ["ci"]
