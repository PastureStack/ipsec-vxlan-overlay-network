FROM ubuntu:26.04@sha256:3131b4cc82a783df6c9df078f86e01819a13594b865c2cad47bd1bca2b7063bb

ARG DAPPER_HOST_ARCH=amd64
ARG GO_VERSION=1.26.5
ARG DOCKER_VERSION=29.5.2
ARG UBUNTU_MIRROR=http://archive.ubuntu.com/ubuntu
ARG GO_LINUX_AMD64_SHA256=5c2c3b16caefa1d968a94c1daca04a7ca301a496d9b086e17ad77bb81393f053
ARG DOCKER_LINUX_AMD64_SHA256=6d81a5be56232d9cc047e60b7110a087793536ae5a8b465719cd303f05fc56ec

ENV DEBIAN_FRONTEND=noninteractive
ENV HOST_ARCH=${DAPPER_HOST_ARCH} ARCH=${DAPPER_HOST_ARCH}

RUN set -eux; \
    if [ -f /etc/apt/sources.list.d/ubuntu.sources ]; then \
        sed -i "s|http://archive.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g; s|http://security.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g" /etc/apt/sources.list.d/ubuntu.sources; \
    fi; \
    apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        file \
        gcc \
        git \
        jq \
        libc6-dev \
        make \
        tar \
        xz-utils && \
    rm -rf /var/lib/apt/lists/* && \
    rm -f /usr/bin/pebble && \
    rm -f /bin/sh && ln -s /bin/bash /bin/sh

ENV GOPATH=/go \
    PATH=/go/bin:/usr/local/go/bin:${PATH} \
    SHELL=/bin/bash \
    GO111MODULE=off \
    GO15VENDOREXPERIMENT=1 \
    GOCACHE=/tmp/go-build-cache \
    GOTELEMETRY=off \
    XDG_CONFIG_HOME=/tmp/go-config \
    GIT_CONFIG_GLOBAL=/tmp/gitconfig

RUN test "${DAPPER_HOST_ARCH}" = amd64 && \
    curl -fsSL -o /tmp/go.tgz "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" && \
    echo "${GO_LINUX_AMD64_SHA256}  /tmp/go.tgz" | sha256sum -c - && \
    tar -xzf /tmp/go.tgz -C /usr/local && \
    rm -f /tmp/go.tgz && \
    go version

RUN curl -fsSL -o /tmp/docker.tgz "https://download.docker.com/linux/static/stable/x86_64/docker-${DOCKER_VERSION}.tgz" && \
    echo "${DOCKER_LINUX_AMD64_SHA256}  /tmp/docker.tgz" | sha256sum -c - && \
    tar xzf /tmp/docker.tgz -C /usr/bin --strip-components=1 docker/docker && \
    rm -f /tmp/docker.tgz && \
    chmod +x /usr/bin/docker && \
    docker --version

ENV DAPPER_ENV="REPO IMAGE_NAMESPACE TAG IMAGE_REVISION VERSION_OVERRIDE RELEASE_VERSION SOURCE_DATE_EPOCH METADATA_CNI_IPAM_BINARY METADATA_CNI_IPAM_URL METADATA_CNI_IPAM_SHA256 PER_HOST_SUBNET_BINARY PER_HOST_SUBNET_URL PER_HOST_SUBNET_SHA256 HOST_LOCAL_CNI_IPAM_BINARY HOST_LOCAL_CNI_IPAM_URL HOST_LOCAL_CNI_IPAM_SHA256 FLAT_CNI_IPAM_BINARY FLAT_CNI_IPAM_URL FLAT_CNI_IPAM_SHA256 MOUNT_PROPAGATION_BINARY MOUNT_PROPAGATION_URL MOUNT_PROPAGATION_SHA256 DOCKER_BUILD_NETWORK UBUNTU_MIRROR"
ENV DAPPER_SOURCE=/go/src/github.com/PastureStack/ipsec-vxlan-overlay-network
ENV DAPPER_OUTPUT="./bin ./dist"
ENV DAPPER_DOCKER_SOCKET=true
ENV HOME=${DAPPER_SOURCE}
WORKDIR ${DAPPER_SOURCE}

RUN git config --system --add safe.directory ${DAPPER_SOURCE}

ENTRYPOINT ["./scripts/entry"]
CMD ["ci"]
