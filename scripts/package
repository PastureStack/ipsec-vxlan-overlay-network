#!/bin/bash
set -euo pipefail

source "$(dirname "$0")/version"
cd "$(dirname "$0")/.."

cleanup_package_staging() {
    rm -f package/ubuntu-apt.lock
}
trap cleanup_package_staging EXIT

METADATA_CNI_IPAM_URL=${METADATA_CNI_IPAM_URL:-https://github.com/PastureStack/metadata-cni-ipam/releases/download/v0.2.7/metadata-cni-ipam-0.2.7-linux-amd64}
METADATA_CNI_IPAM_SHA256=${METADATA_CNI_IPAM_SHA256:-acde77de17d117f32dd2bbc80dae212c7209165f8101299eaea10561cf058d76}
PER_HOST_SUBNET_URL=${PER_HOST_SUBNET_URL:-https://github.com/PastureStack/per-host-subnet/releases/download/v0.2.8/per-host-subnet-v0.2.8-linux-amd64}
PER_HOST_SUBNET_SHA256=${PER_HOST_SUBNET_SHA256:-d12acca4526eee45d52b87541717ae81432225d9c5dabfd823d6b43631c20e84}
HOST_LOCAL_CNI_IPAM_URL=${HOST_LOCAL_CNI_IPAM_URL:-https://github.com/PastureStack/host-local-cni-ipam/releases/download/v0.1.4/host-local-cni-ipam-0.1.4-linux-amd64}
HOST_LOCAL_CNI_IPAM_SHA256=${HOST_LOCAL_CNI_IPAM_SHA256:-9bb79b9f269663715f44aea898854df0e0e319a3ba35e4d52db5477cde026e3e}
FLAT_CNI_IPAM_URL=${FLAT_CNI_IPAM_URL:-https://github.com/PastureStack/flat-cni-ipam/releases/download/v0.1.4/flat-cni-ipam-v0.1.4-linux-amd64}
FLAT_CNI_IPAM_SHA256=${FLAT_CNI_IPAM_SHA256:-edbbe0924637381f95b268b259170d80434d3c37e0a5a7519c7e55b2e8957db5}
MOUNT_PROPAGATION_URL=${MOUNT_PROPAGATION_URL:-https://github.com/PastureStack/mount-propagation/releases/download/v1.0.11/mount-propagation-v1.0.11-linux-amd64}
MOUNT_PROPAGATION_SHA256=${MOUNT_PROPAGATION_SHA256:-800bbc2d74c318ccc62d2c3c76846ee1fe307c21daf558c7edcf5de25e393a4b}

TAG=${TAG:-${VERSION}}
REPO=${REPO:-ghcr.io/${IMAGE_NAMESPACE:-pasturestack}}
IMAGE_NAME=${IMAGE_NAME:-ipsec-vxlan-overlay-network}
IMAGE_REVISION=${IMAGE_REVISION:-$(git rev-parse --verify HEAD 2>/dev/null || true)}
IMAGE_REVISION=${IMAGE_REVISION:-unknown}

if echo "$TAG" | grep -q dirty; then
    echo "Refusing to package a dirty version: $TAG" >&2
    exit 1
fi
if ! printf '%s\n' "$IMAGE_REVISION" | grep -Eq '^([0-9a-f]{40}|unknown)$'; then
    echo "Invalid image revision: $IMAGE_REVISION" >&2
    exit 1
fi
if ! printf '%s\n' "$TAG" | grep -Eq '^[0-9]+[.][0-9]+[.][0-9]+$'; then
    echo "Image tag must be numeric SemVer: $TAG" >&2
    exit 1
fi
if [ "$IMAGE_REVISION" = unknown ]; then
    echo "A 40-character IMAGE_REVISION is required for a versioned image" >&2
    exit 1
fi

mkdir -p dist/dependencies

stage_binary() {
    local destination=$1
    local local_binary=$2
    local url=$3
    local sha256=$4
    local cache="dist/dependencies/${destination}"

    rm -f "$cache.tmp"
    if [ -n "$local_binary" ]; then
        if [ ! -x "$local_binary" ]; then
            echo "Local dependency is not executable: $local_binary" >&2
            exit 1
        fi
        cp "$local_binary" "$cache"
    else
        curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 \
            -o "$cache.tmp" "$url"
        mv "$cache.tmp" "$cache"
    fi
    echo "$sha256  $cache" | sha256sum -c -
    install -m 0755 "$cache" "package/$destination"
}

install -m 0755 bin/ipsec-vxlan-overlay-network package/ipsec-vxlan-overlay-network
install -m 0755 bin/ipsec-vxlan-overlay-topology package/ipsec-vxlan-overlay-topology
stage_binary metadata-cni-ipam "${METADATA_CNI_IPAM_BINARY:-}" "$METADATA_CNI_IPAM_URL" "$METADATA_CNI_IPAM_SHA256"
stage_binary per-host-subnet "${PER_HOST_SUBNET_BINARY:-}" "$PER_HOST_SUBNET_URL" "$PER_HOST_SUBNET_SHA256"
stage_binary host-local-cni-ipam "${HOST_LOCAL_CNI_IPAM_BINARY:-}" "$HOST_LOCAL_CNI_IPAM_URL" "$HOST_LOCAL_CNI_IPAM_SHA256"
stage_binary flat-cni-ipam "${FLAT_CNI_IPAM_BINARY:-}" "$FLAT_CNI_IPAM_URL" "$FLAT_CNI_IPAM_SHA256"
stage_binary mount-propagation "${MOUNT_PROPAGATION_BINARY:-}" "$MOUNT_PROPAGATION_URL" "$MOUNT_PROPAGATION_SHA256"

rm -rf package/licenses
mkdir -p package/licenses/source package/licenses/vendor
install -m 0644 ubuntu-apt.lock package/ubuntu-apt.lock
install -m 0644 LICENSE package/licenses/source/LICENSE
for license in LICENSES/*; do
    install -m 0644 "$license" "package/licenses/source/$(basename "$license")"
done
for document in COMPATIBILITY.md ORIGIN.md SECURITY.md THIRD_PARTY_NOTICES.md; do
    install -m 0644 "$document" "package/licenses/source/$document"
done
while IFS= read -r -d '' license; do
    relative=${license#vendor/}
    mkdir -p "package/licenses/vendor/$(dirname "$relative")"
    install -m 0644 "$license" "package/licenses/vendor/$relative"
done < <(find vendor -type f \( -iname 'LICENSE*' -o -iname 'COPYING*' -o -iname 'NOTICE*' -o -iname 'PATENTS*' \) -print0)

docker build \
    --pull \
    --platform linux/amd64 \
    --provenance=false \
    --network "${DOCKER_BUILD_NETWORK:-host}" \
    --build-arg IMAGE_VERSION="$TAG" \
    --build-arg IMAGE_REVISION="$IMAGE_REVISION" \
    -t "$REPO/$IMAGE_NAME:$TAG" \
    package

mkdir -p dist
printf '%s\n' "$REPO/$IMAGE_NAME:$TAG" > dist/images
echo "Built $REPO/$IMAGE_NAME:$TAG"
