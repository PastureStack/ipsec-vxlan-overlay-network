#!/bin/bash
set -euo pipefail

image=${IMAGE:-local/pasturestack/ipsec-vxlan-overlay-network:0.14.37}
old_image=${OLD_IMAGE:-}
startup_image=${old_image:-$image}
test_id=$$
network="pasture-overlay-it-${test_id}"
node_a="pasture-overlay-a-${test_id}"
node_b="pasture-overlay-b-${test_id}"
work_dir=$(mktemp -d)

cleanup() {
    docker rm -f "$node_a" "$node_b" >/dev/null 2>&1 || true
    docker network rm "$network" >/dev/null 2>&1 || true
    rm -rf "$work_dir"
}
trap cleanup EXIT

dump_logs() {
    echo "--- node A ---" >&2
    docker logs --tail 120 "$node_a" >&2 || true
    echo "--- node B ---" >&2
    docker logs --tail 120 "$node_b" >&2 || true
}

docker image inspect "$image" >/dev/null
if [ -n "$old_image" ]; then
    docker pull "$old_image" >/dev/null
fi
docker network create --driver bridge --subnet 172.31.253.0/24 "$network" >/dev/null

mkdir -p "$work_dir/node-a/ipsec" "$work_dir/node-b/ipsec"
printf '%s\n' 'pasturestack-integration-test-only' > "$work_dir/node-a/ipsec/psk.txt"
printf '%s\n' 'pasturestack-integration-test-only' > "$work_dir/node-b/ipsec/psk.txt"

cat > "$work_dir/node-a/config.json" <<'EOF'
{"entries":[
  {"peer":true,"self":true,"ip":"10.42.253.10/16","hostIp":"172.31.253.10"},
  {"peer":true,"ip":"10.42.253.11/16","hostIp":"172.31.253.11"}
]}
EOF

cat > "$work_dir/node-b/config.json" <<'EOF'
{"entries":[
  {"peer":true,"ip":"10.42.253.10/16","hostIp":"172.31.253.10"},
  {"peer":true,"self":true,"ip":"10.42.253.11/16","hostIp":"172.31.253.11"}
]}
EOF

start_node() {
    local name=$1
    local underlay=$2
    local overlay=$3
    local remote_overlay=$4
    local config_dir=$5

    docker run -d \
        --name "$name" \
        --privileged \
        --network "$network" \
        --ip "$underlay" \
        --entrypoint /bin/bash \
        -v "$config_dir:/test:ro" \
        "$startup_image" \
        -c "
            set -euo pipefail
            ip address add ${overlay}/32 dev eth0
            ip route add ${remote_overlay}/32 via 172.31.253.1 dev eth0 src ${overlay}
            exec ipsec-vxlan-overlay-network \\
                --file /test/config.json \\
                --local-ip ${overlay}/16 \\
                --ipsec-config /test/ipsec \\
                --charon-launch \\
                --xfrm-tunnel-source host \\
                --listen :8111 \\
                --pid-file /var/run/ipsec-vxlan-overlay-network.pid
        " >/dev/null
}

start_node "$node_a" 172.31.253.10 10.42.253.10 10.42.253.11 "$work_dir/node-a"
start_node "$node_b" 172.31.253.11 10.42.253.11 10.42.253.10 "$work_dir/node-b"

ready=false
for attempt in $(seq 1 60); do
    if docker exec "$node_a" swanctl --list-sas --raw 2>/dev/null | grep -q 'child-172.31.253.11' && \
       docker exec "$node_b" swanctl --list-sas --raw 2>/dev/null | grep -q 'child-172.31.253.10'; then
        ready=true
        break
    fi
    sleep 1
done

if [ "$ready" != true ]; then
    dump_logs
    echo "IPsec security associations did not become ready" >&2
    exit 1
fi

if [ -n "$old_image" ]; then
    # Attempt the live upgrade's duplicate starting state. strongSwan may
    # converge these test-only initiations itself; the live gate remains the
    # authority for that scenario, while this still tests a rolling handoff.
    docker exec "$node_a" swanctl --initiate --ike conn-172.31.253.11 --timeout 20 >"$work_dir/old-initiate-a.log" 2>&1 &
    old_extra_a=$!
    docker exec "$node_b" swanctl --initiate --ike conn-172.31.253.10 --timeout 20 >"$work_dir/old-initiate-b.log" 2>&1 &
    old_extra_b=$!
    wait "$old_extra_a" || true
    wait "$old_extra_b" || true
    old_duplicate=false
    for attempt in $(seq 1 30); do
        count_a=$(docker exec "$node_a" swanctl --list-sas --raw 2>/dev/null | grep -c '^list-sa event' || true)
        count_b=$(docker exec "$node_b" swanctl --list-sas --raw 2>/dev/null | grep -c '^list-sa event' || true)
        if [ "$count_a" -ge 2 ] && [ "$count_b" -ge 2 ]; then
            old_duplicate=true
            break
        fi
        sleep 1
    done
    echo "OLD_DUPLICATE_REPRODUCED=$old_duplicate"
    if [ "$old_duplicate" != true ]; then
        cat "$work_dir/old-initiate-a.log" "$work_dir/old-initiate-b.log" >&2
    fi

    # Roll one peer at a time, keeping the other peer alive.  The candidate
    # must restore encrypted traffic before and after the second handoff.
    startup_image=$image
    docker rm -f "$node_a" >/dev/null
    start_node "$node_a" 172.31.253.10 10.42.253.10 10.42.253.11 "$work_dir/node-a"
    first_handoff=false
    for attempt in $(seq 1 60); do
        if docker exec "$node_a" ping -c 1 -W 1 -I 10.42.253.10 10.42.253.11 >/dev/null 2>&1; then
            first_handoff=true
            break
        fi
        sleep 1
    done
    if [ "$first_handoff" != true ]; then
        dump_logs
        echo "First rolling upgrade handoff did not restore encrypted traffic" >&2
        exit 1
    fi
    docker rm -f "$node_b" >/dev/null
    start_node "$node_b" 172.31.253.11 10.42.253.11 10.42.253.10 "$work_dir/node-b"
    ready=false
    for attempt in $(seq 1 60); do
        if docker exec "$node_a" swanctl --list-sas --raw 2>/dev/null | grep -q 'child-172.31.253.11' && \
           docker exec "$node_b" swanctl --list-sas --raw 2>/dev/null | grep -q 'child-172.31.253.10'; then
            ready=true
            break
        fi
        sleep 1
    done
    if [ "$ready" != true ]; then
        dump_logs
        echo "Second rolling upgrade handoff did not establish IPsec" >&2
        exit 1
    fi
fi

if ! docker exec "$node_a" ping -c 3 -W 2 -I 10.42.253.10 10.42.253.11 >/dev/null; then
    dump_logs
    docker exec "$node_a" ip -s xfrm state >&2 || true
    docker exec "$node_a" ip xfrm policy >&2 || true
    echo "Encrypted overlay traffic test failed" >&2
    exit 1
fi

state_a=$(docker exec "$node_a" ip -s xfrm state)
state_b=$(docker exec "$node_b" ip -s xfrm state)
counter_pattern='([1-9][0-9]*\(bytes\)|bytes[[:space:]]+[1-9][0-9]*)'
if ! grep -Eq "$counter_pattern" <<<"$state_a" || ! grep -Eq "$counter_pattern" <<<"$state_b"; then
    dump_logs
    printf '%s\n' "$state_a" >&2
    printf '%s\n' "$state_b" >&2
    echo "IPsec associations did not record encrypted traffic" >&2
    exit 1
fi

single_sa_on_both_nodes() {
    local count_a count_b
    count_a=$(docker exec "$node_a" swanctl --list-sas --raw 2>/dev/null | grep -c '^list-sa event' || true)
    count_b=$(docker exec "$node_b" swanctl --list-sas --raw 2>/dev/null | grep -c '^list-sa event' || true)
    [ "$count_a" = 1 ] && [ "$count_b" = 1 ]
}

wait_for_single_working_sa() {
    local attempt
    for attempt in $(seq 1 180); do
        # Keep exercising the data path while the 120-second quiet period and
        # 30-second health reconciler decide whether an old SA is truly idle.
        if docker exec "$node_a" ping -c 1 -W 1 -I 10.42.253.10 10.42.253.11 >/dev/null 2>&1 &&
           single_sa_on_both_nodes; then
            return 0
        fi
        sleep 1
    done
    return 1
}

dump_sas() {
    docker exec "$node_a" swanctl --list-sas --raw >&2 || true
    docker exec "$node_b" swanctl --list-sas --raw >&2 || true
}

if ! wait_for_single_working_sa; then
    dump_logs
    dump_sas
    echo "Initial connection did not converge to one working IKE SA" >&2
    exit 1
fi

# Force both peers to propose another IKE SA while the existing tunnel is
# healthy. The older default policy (unique=no) retains both indefinitely.
docker exec "$node_a" swanctl --initiate --ike conn-172.31.253.11 --timeout 20 >/dev/null 2>&1 &
extra_a=$!
docker exec "$node_b" swanctl --initiate --ike conn-172.31.253.10 --timeout 20 >/dev/null 2>&1 &
extra_b=$!
wait "$extra_a" || true
wait "$extra_b" || true
if ! wait_for_single_working_sa; then
    dump_logs
    dump_sas
    echo "Concurrent initiation left duplicate or unusable IKE SAs" >&2
    exit 1
fi

# Simulate a peer restart without resetting the surviving node. This is where
# concurrent initiation previously left two long-lived SAs for one peer.
docker restart --time 5 "$node_b" >/dev/null
if ! wait_for_single_working_sa; then
    dump_logs
    dump_sas
    echo "Peer restart did not converge to one working IKE SA" >&2
    exit 1
fi

printf '%s\n' 'TWO_NODE_IPSEC=pass'
