#!/bin/bash
set -euo pipefail

cd "$(dirname "$0")/.."

expected_modules=$(mktemp)
observed_modules=$(mktemp)
trap 'rm -f "$expected_modules" "$observed_modules"' EXIT

awk '
    /^[[:space:]]*($|#)/ { next }
    NF != 4 { print "vendor.lock:" NR ": expected four fields" > "/dev/stderr"; exit 1 }
    $2 !~ /^[0-9a-f]{40}$/ { print "vendor.lock:" NR ": revision is not a full commit" > "/dev/stderr"; exit 1 }
    $3 !~ /^[0-9a-f]{64}$/ { print "vendor.lock:" NR ": invalid tree digest" > "/dev/stderr"; exit 1 }
    $4 !~ /^[0-9]+$/ { print "vendor.lock:" NR ": invalid file count" > "/dev/stderr"; exit 1 }
    seen[$1]++ { print "vendor.lock:" NR ": duplicate module " $1 > "/dev/stderr"; exit 1 }
    { print $1 }
' vendor.lock | LC_ALL=C sort > "$expected_modules"

find vendor/github.com -mindepth 2 -maxdepth 2 -type d -print0 |
    while IFS= read -r -d '' path; do
        if find "$path" -type f -print -quit | grep -q .; then
            printf '%s\n' "${path#vendor/}"
        fi
    done > "$observed_modules"
find vendor/golang.org/x vendor/gopkg.in -mindepth 1 -maxdepth 1 -type d -print0 |
    while IFS= read -r -d '' path; do
        if find "$path" -type f -print -quit | grep -q .; then
            printf '%s\n' "${path#vendor/}"
        fi
    done >> "$observed_modules"
LC_ALL=C sort -u -o "$observed_modules" "$observed_modules"
diff -u "$expected_modules" "$observed_modules"

while read -r module revision expected_digest expected_count; do
    case "$module" in ''|'#'*) continue ;; esac
    module_path="vendor/$module"
    actual_count=$(find "$module_path" -type f | wc -l)
    actual_digest=$(
        find "$module_path" -type f -print0 |
            LC_ALL=C sort -z |
            while IFS= read -r -d '' path; do
                printf '%s\n' "$path"
                cat "$path"
                printf '\n'
            done |
            sha256sum |
            awk '{print $1}'
    )
    if [ "$actual_count" -ne "$expected_count" ] || [ "$actual_digest" != "$expected_digest" ]; then
        printf '%s: expected files=%s sha256=%s; got files=%s sha256=%s\n' \
            "$module" "$expected_count" "$expected_digest" "$actual_count" "$actual_digest" >&2
        exit 1
    fi
done < vendor.lock

printf 'vendor_lock_modules=%s\n' "$(wc -l < "$expected_modules")"
