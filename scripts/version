#!/bin/bash
set -euo pipefail

candidate=${VERSION_OVERRIDE:-${RELEASE_VERSION:-}}
if [ -z "$candidate" ] && git rev-parse --git-dir >/dev/null 2>&1 && [ -z "$(git status --porcelain --untracked-files=no)" ]; then
    mapfile -t numeric_tags < <(git tag --points-at HEAD | grep -E '^[0-9]+[.][0-9]+[.][0-9]+$' || true)
    if [ "${#numeric_tags[@]}" -eq 1 ]; then
        candidate=${numeric_tags[0]}
    elif [ "${#numeric_tags[@]}" -gt 1 ]; then
        echo "Multiple numeric release tags point at HEAD" >&2
        return 1 2>/dev/null || exit 1
    fi
fi

VERSION=${candidate:-0.0.0}
if ! [[ "$VERSION" =~ ^[0-9]+[.][0-9]+[.][0-9]+$ ]]; then
    echo "Version must be numeric SemVer: $VERSION" >&2
    return 1 2>/dev/null || exit 1
fi
