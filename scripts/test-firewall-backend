#!/bin/bash
set -euo pipefail

cd "$(dirname "$0")/.."
source package/firewall-backend.sh

command_log=$(mktemp)
trap 'rm -f "$command_log"' EXIT
TEST_DRIVER=iptables
TEST_NATIVE=absent
TEST_NFT=absent
TEST_LEGACY=absent
TEST_LEGACY_LOADED=false
TEST_LEGACY_FILTER_LOADED=false
TEST_LEGACY_LIST=normal
TEST_NFT_CATTLE=none
TEST_LEGACY_CATTLE=none
TEST_NFT_FORWARD_DROP=false
TEST_LEGACY_FORWARD_DROP=false
TEST_NFT_FILTER=normal

ipsec-vxlan-overlay-network() {
    printf 'driver %s\n' "$*" >>"$command_log"
    [ "$*" = docker-firewall-driver ] || return 1
    [ "$TEST_DRIVER" != error ] || return 1
    echo "$TEST_DRIVER"
}

host_netns_cmd() {
    printf '%s\n' "$*" >>"$command_log"
    case "$*" in
        "nft list table ip docker-bridges")
            case "$TEST_NATIVE" in
                active) printf 'table ip docker-bridges {\n chain filter-FORWARD { type filter hook forward priority filter; }\n chain nat-POSTROUTING { type nat hook postrouting priority srcnat; }\n}\n' ;;
                stale) printf 'table ip docker-bridges {\n chain filter-FORWARD { }\n}\n' ;;
                absent) echo 'Error: No such file or directory' >&2; return 1 ;;
                unsupported) echo 'Error: Operation not supported' >&2; return 1 ;;
                error) echo 'Error: Permission denied' >&2; return 1 ;;
            esac ;;
        "iptables-nft -t nat -S"|"iptables-legacy -t nat -S")
            local state=$TEST_NFT
            [ "$*" = "iptables-legacy -t nat -S" ] && state=$TEST_LEGACY
            case "$state" in
                active) printf '%s\n' '-N DOCKER' '-A PREROUTING -m addrtype --dst-type LOCAL -j DOCKER' ;;
                stale) printf '%s\n' '-N DOCKER' ;;
                absent) printf '%s\n' '-P PREROUTING ACCEPT' ;;
                error) echo 'Permission denied' >&2; return 1 ;;
                unsupported) echo 'Protocol not supported' >&2; return 1 ;;
                unsupported_generation) echo 'Could not fetch rule set generation id: Invalid argument' >&2; return 1 ;;
            esac
            local cattle=$TEST_NFT_CATTLE
            [ "$*" = "iptables-legacy -t nat -S" ] && cattle=$TEST_LEGACY_CATTLE
            case "$cattle" in
                nat) echo '-N CATTLE_NAT_POSTROUTING'; echo '-A POSTROUTING -j CATTLE_NAT_POSTROUTING' ;;
                orphan) echo '-N CATTLE_NAT_POSTROUTING' ;;
            esac ;;
        "iptables-nft -t filter -S"|"iptables-legacy -t filter -S")
            if [ "$*" = "iptables-nft -t filter -S" ]; then
                [ "$TEST_NFT_FILTER" != unsupported ] || { echo 'Protocol not supported' >&2; return 1; }
                [ "$TEST_NFT_FILTER" != unsupported_generation ] || { echo 'Could not fetch rule set generation id: Invalid argument' >&2; return 1; }
                [ "$TEST_NFT_FILTER" != error ] || { echo 'Permission denied' >&2; return 1; }
                if [ "$TEST_NFT_FORWARD_DROP" = true ]; then echo '-P FORWARD DROP'; else echo '-P FORWARD ACCEPT'; fi
                case "$TEST_NFT_CATTLE" in
                    filter) echo '-N CATTLE_FORWARD'; echo '-A FORWARD -j CATTLE_FORWARD' ;;
                    indirect) echo '-N CATTLE_FORWARD'; echo '-A FORWARD -j DOCKER-USER'; echo '-A DOCKER-USER -j CATTLE_FORWARD' ;;
                    orphan) echo '-N CATTLE_FORWARD' ;;
                esac
            else
                if [ "$TEST_LEGACY_FORWARD_DROP" = true ]; then echo '-P FORWARD DROP'; else echo '-P FORWARD ACCEPT'; fi
                case "$TEST_LEGACY_CATTLE" in
                    filter) echo '-N CATTLE_FORWARD'; echo '-A FORWARD -j CATTLE_FORWARD' ;;
                    indirect) echo '-N CATTLE_FORWARD'; echo '-A FORWARD -j DOCKER-USER'; echo '-A DOCKER-USER -j CATTLE_FORWARD' ;;
                    orphan) echo '-N CATTLE_FORWARD' ;;
                esac
            fi ;;
        "ipsec-vxlan-overlay-network legacy-loaded-tables")
            [ "$TEST_LEGACY_LIST" != error ] || { echo 'Permission denied' >&2; return 1; }
            [ "$TEST_LEGACY_LIST" != missing ] || return 0
            if [ "$TEST_LEGACY_LOADED" = true ]; then echo nat; fi
            if [ "$TEST_LEGACY_FILTER_LOADED" = true ]; then echo filter; fi ;;
        "iptables-nft -t nat -S CATTLE_NAT_POSTROUTING"|"iptables-legacy -t nat -S CATTLE_NAT_POSTROUTING") return 1 ;;
        "iptables-nft -t nat -C POSTROUTING"*|"iptables-legacy -t nat -C POSTROUTING"*|"iptables -t nat -C POSTROUTING"*) return 1 ;;
        "iptables-nft -t nat -I POSTROUTING"*|"iptables-legacy -t nat -I POSTROUTING"*|"iptables -t nat -I POSTROUTING"*) return 0 ;;
        *) echo "Unexpected firewall command: $*" >&2; return 1 ;;
    esac
}

reset_case() {
    : >"$command_log"
    TEST_DRIVER=iptables
    TEST_NATIVE=absent
    TEST_NFT=absent
    TEST_LEGACY=absent
    TEST_LEGACY_LOADED=false
    TEST_LEGACY_FILTER_LOADED=false
    TEST_LEGACY_LIST=normal
    TEST_NFT_CATTLE=none
    TEST_LEGACY_CATTLE=none
    TEST_NFT_FORWARD_DROP=false
    TEST_LEGACY_FORWARD_DROP=false
    TEST_NFT_FILTER=normal
    PASTURESTACK_FIREWALL_BACKEND=auto
}

expect_mode() {
    local expected=$1
    if ! resolve_firewall_backend; then
        echo "Expected $expected but backend detection failed" >&2
        exit 1
    fi
    [ "$PASTURESTACK_FIREWALL_BACKEND" = "$expected" ] || {
        echo "Expected $expected, got $PASTURESTACK_FIREWALL_BACKEND" >&2
        exit 1
    }
}

expect_reject() {
    if resolve_firewall_backend; then
        echo "Unsafe firewall state was accepted: driver=$TEST_DRIVER native=$TEST_NATIVE nft=$TEST_NFT legacy=$TEST_LEGACY" >&2
        exit 1
    fi
    case " $(<"$command_log") " in
        *" -I "*|*" -C "*) echo "Firewall mutated after a failed probe" >&2; exit 1 ;;
    esac
}

reset_case
TEST_DRIVER=nftables
TEST_NATIVE=active
expect_mode nftables
configure_overlay_firewall true 192.0.2.1 eth0
case " $(<"$command_log") " in
    *" -I "*|*" -D "*|*" -N "*|*" -F "*) echo 'IPsec router mutated manager-owned host firewall rules' >&2; exit 1 ;;
esac
case " $(<"$command_log") " in *iptables-legacy*) echo 'Unloaded legacy NAT was probed' >&2; exit 1 ;; esac

# On an nft-only host /proc/net/ip_tables_names can be absent. The Go helper
# treats precisely ENOENT as no loaded legacy table; other read failures must
# stop before any firewall mutation.
reset_case; TEST_DRIVER=nftables; TEST_NATIVE=active; TEST_LEGACY_LIST=missing; expect_mode nftables
reset_case; TEST_DRIVER=nftables; TEST_NATIVE=active; TEST_LEGACY_LIST=error; expect_reject

reset_case
TEST_NFT=active
configure_overlay_firewall true 192.0.2.1 eth0
[[ "$PASTURESTACK_FIREWALL_BACKEND" = iptables-nft ]]
case " $(<"$command_log") " in
    *" -I "*|*" -D "*|*" -N "*|*" -F "*) echo 'IPsec router mutated manager-owned host firewall rules' >&2; exit 1 ;;
esac

reset_case
TEST_LEGACY_LOADED=true
TEST_LEGACY=active
configure_overlay_firewall true 192.0.2.1 eth0
[[ "$PASTURESTACK_FIREWALL_BACKEND" = iptables-legacy ]]
[[ " $(<"$command_log") " == *"iptables-legacy -t nat -S"* ]]
case " $(<"$command_log") " in
    *" -I "*|*" -D "*|*" -N "*|*" -F "*) echo 'IPsec router mutated manager-owned host firewall rules' >&2; exit 1 ;;
esac

# A table or DOCKER chain without an active base hook is never evidence of the
# current daemon backend; contradictory or dual-active observations fail closed.
reset_case; TEST_DRIVER=nftables; TEST_NATIVE=stale; expect_reject
reset_case; TEST_NFT=stale; expect_reject
reset_case; TEST_DRIVER=nftables; TEST_NATIVE=active; TEST_NFT=active; expect_reject
reset_case; TEST_NFT=active; TEST_LEGACY_LOADED=true; TEST_LEGACY=active; expect_reject
reset_case; TEST_NFT=active; TEST_LEGACY_LOADED=true; TEST_LEGACY=stale; expect_reject
reset_case; TEST_NATIVE=stale; TEST_NFT=active; expect_reject
reset_case; TEST_DRIVER=nftables; TEST_NATIVE=active; TEST_LEGACY_LOADED=true; TEST_LEGACY=stale; expect_reject
reset_case; TEST_DRIVER=nftables; TEST_NATIVE=absent; expect_reject
reset_case; TEST_DRIVER=iptables; TEST_NATIVE=active; expect_reject
reset_case; TEST_NATIVE=error; expect_reject
reset_case; TEST_NFT=error; expect_reject
reset_case; TEST_DRIVER=error; expect_reject
reset_case; TEST_NFT=unsupported; TEST_NFT_FILTER=unsupported; TEST_LEGACY_LOADED=true; TEST_LEGACY=active; expect_mode iptables-legacy
reset_case; TEST_NATIVE=unsupported; TEST_NFT=unsupported; TEST_NFT_FILTER=unsupported; TEST_LEGACY_LOADED=true; TEST_LEGACY=active; expect_mode iptables-legacy
reset_case; TEST_NATIVE=unsupported; TEST_NFT=unsupported_generation; TEST_NFT_FILTER=unsupported_generation; TEST_LEGACY_LOADED=true; TEST_LEGACY=active; expect_mode iptables-legacy

# Old platform hooks may still process packets after a Docker backend switch.
# An orphan chain is harmless here; only reachable hooks or an opposite
# FORWARD DROP policy must block startup.
reset_case; TEST_DRIVER=nftables; TEST_NATIVE=active; TEST_NFT_CATTLE=nat; expect_reject
reset_case; TEST_DRIVER=nftables; TEST_NATIVE=active; TEST_NFT_CATTLE=indirect; expect_reject
reset_case; TEST_DRIVER=nftables; TEST_NATIVE=active; TEST_NFT_FORWARD_DROP=true; expect_reject
reset_case; TEST_DRIVER=nftables; TEST_NATIVE=active; TEST_LEGACY_FILTER_LOADED=true; TEST_LEGACY_FORWARD_DROP=true; expect_reject
reset_case; TEST_DRIVER=nftables; TEST_NATIVE=active; TEST_LEGACY_LOADED=true; TEST_LEGACY_CATTLE=nat; expect_reject
reset_case; TEST_DRIVER=nftables; TEST_NATIVE=active; TEST_NFT_CATTLE=orphan; expect_mode nftables
reset_case; TEST_NFT=active; TEST_LEGACY_LOADED=true; TEST_LEGACY_CATTLE=nat; expect_reject
reset_case; TEST_NFT=active; TEST_LEGACY_FILTER_LOADED=true; TEST_LEGACY_CATTLE=filter; expect_reject
reset_case; TEST_NFT=active; TEST_LEGACY_FILTER_LOADED=true; TEST_LEGACY_FORWARD_DROP=true; expect_reject
reset_case; TEST_NFT=active; TEST_LEGACY_FILTER_LOADED=true; TEST_LEGACY_CATTLE=orphan; expect_mode iptables-nft
reset_case; TEST_LEGACY_LOADED=true; TEST_LEGACY=active; TEST_NFT_CATTLE=nat; expect_reject
reset_case; TEST_LEGACY_LOADED=true; TEST_LEGACY=active; TEST_NFT_FORWARD_DROP=true; expect_reject
reset_case; TEST_LEGACY_LOADED=true; TEST_LEGACY=active; TEST_NFT_CATTLE=orphan; expect_mode iptables-legacy

reset_case; TEST_NFT=active; PASTURESTACK_FIREWALL_BACKEND=iptables-legacy; expect_reject
reset_case; TEST_DRIVER=nftables; TEST_NATIVE=active; PASTURESTACK_FIREWALL_BACKEND=iptables-nft; expect_reject
reset_case; TEST_LEGACY_LOADED=false; TEST_LEGACY=active; PASTURESTACK_FIREWALL_BACKEND=iptables-legacy; expect_reject
case " $(<"$command_log") " in *iptables-legacy*) echo 'Unloaded legacy NAT was probed' >&2; exit 1 ;; esac

# The historical container-network-namespace path is independent of Docker
# host probing, including the newly required Docker /info request.
reset_case
TEST_DRIVER=error
configure_overlay_firewall false 192.0.2.1 eth0
[[ " $(<"$command_log") " == *"iptables -t nat -I POSTROUTING -o eth0 -s 192.0.2.1 -j MASQUERADE"* ]]
case " $(<"$command_log") " in
    *driver*|*nft*|*iptables-legacy*) echo 'Container-netns mode probed the Docker host' >&2; exit 1 ;;
esac

echo FIREWALL_BACKEND_TEST=pass
